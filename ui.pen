                      "fill": "#52525B",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Built a robust Power BI model leveraging over 30 transformation steps and referenced queries, enabling seamless, no-code data refresh capabilities and enhanced connectivity across data sources.",
                      "lineHeight": 1.48,
                      "fontFamily": "Inter",
                      "fontSize": 11,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
