                0
              ],
              "children": [
                {
                  "type": "text",
                  "id": "OAmlg",
                  "name": "Reader Modal Context Label",
                  "fill": "#27272A",
                  "content": "CONTEXT",
                  "fontFamily": "Inter",
                  "fontSize": 11,
                  "fontWeight": "600",
                  "letterSpacing": 0.7
                },
                {
                  "type": "text",
                  "id": "i8Ptm0",
                  "name": "Reader Modal Context Copy",
                  "fill": "#52525B",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The client was seeking to develop a methodology and supporting tooling to assess the impact of integrating Generative AI technologies into daily operations, with a focus on workforce size and distribution, project cost, and organizational capacity.",
                  "lineHeight": 1.52,
                  "fontFamily": "Inter",
                  "fontSize": 12,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "JrAVE",
              "name": "Reader Modal Contributions",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 8,
              "children": [
                {
                  "type": "text",
                  "id": "W7P6TV",
                  "name": "Reader Modal Contributions Label",
                  "fill": "#27272A",
                  "content": "CONTRIBUTIONS",
                  "fontFamily": "Inter",
                  "fontSize": 11,
                  "fontWeight": "600",
                  "letterSpacing": 0.7
                },
                {
                  "type": "text",
                  "id": "zrtmI",
                  "name": "Reader Modal Contributions Intro",
                  "fill": "#52525B",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Stephen was involved as the technical team lead and contributed in the following capacity:",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 12,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "yu4VT",
                  "name": "Reader Modal Contribution 1",
                  "width": "fill_container",
                  "gap": 10,
                  "children": [
                    {
                      "type": "ellipse",
                      "id": "H7eOu",
                      "name": "Reader Modal Contribution 1 Bullet",
                      "fill": "#00A995",
                      "width": 5,
                      "height": 5
                    },
                    {
                      "type": "text",
                      "id": "g4vqx4",
                      "name": "Reader Modal Contribution 1 Copy",
                      "fill": "#52525B",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Designed the assessment methodology by gathering requirements from project sponsors and senior leaders, proposing multiple fidelity levels for analysis, and ultimately recommending a preferred approach aligned with organizational goals, timelines, and desired outcomes.",
                      "lineHeight": 1.48,
                      "fontFamily": "Inter",
                      "fontSize": 11,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "dKfZV",
                  "name": "Reader Modal Contribution 2",
                  "width": "fill_container",
                  "gap": 10,
                  "children": [
                    {
                      "type": "ellipse",
                      "id": "n4i1Dz",
                      "name": "Reader Modal Contribution 2 Bullet",
                      "fill": "#00A995",
                      "width": 5,
                      "height": 5
                    },
                    {
                      "type": "text",
                      "id": "ASSYm",
                      "name": "Reader Modal Contribution 2 Copy",
                      "fill": "#52525B",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Led the development of an operational task inventory and conducted a technology impact analysis to quantify potential disruptions, generating a foundational dataset to support visualization and insight generation.",
                      "lineHeight": 1.48,
                      "fontFamily": "Inter",
                      "fontSize": 11,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "FVq3o",
                  "name": "Reader Modal Contribution 3",
                  "width": "fill_container",
                  "gap": 10,
                  "children": [
                    {
                      "type": "ellipse",
                      "id": "B9ghd",
                      "name": "Reader Modal Contribution 3 Bullet",
                      "fill": "#00A995",
                      "width": 5,
                      "height": 5
                    },
                    {
                      "type": "text",
                      "id": "gaAmS",
                      "name": "Reader Modal Contribution 3 Copy",
                      "fill": "#52525B",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Built a robust Power BI model leveraging over 30 transformation steps and referenced queries, enabling seamless, no-code data refresh capabilities and enhanced connectivity across data sources.",
                      "lineHeight": 1.48,
                      "fontFamily": "Inter",
                      "fontSize": 11,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "N1p7u",
                  "name": "Reader Modal Contribution 4",
                  "width": "fill_container",
                  "gap": 10,
                  "children": [
                    {
                      "type": "ellipse",
                      "id": "Y0tPSm",
                      "name": "Reader Modal Contribution 4 Bullet",
                      "fill": "#00A995",
                      "width": 5,
                      "height": 5
                    },
                    {
                      "type": "text",
                      "id": "wg2dQ",
                      "name": "Reader Modal Contribution 4 Copy",
                      "fill": "#52525B",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Developed a custom Excel function, “=AskGenAI(<prompt>)”, using VBA to enable secure API calls to Azure-hosted large language models (LLMs), allowing users to interact with Generative AI directly within Excel.",
                      "lineHeight": 1.48,
                      "fontFamily": "Inter",
                      "fontSize": 11,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "Pps9O",
                  "name": "Reader Modal Contribution 5",
                  "width": "fill_container",
                  "gap": 10,
                  "children": [
                    {
                      "type": "ellipse",
                      "id": "opp7q",
                      "name": "Reader Modal Contribution 5 Bullet",
                      "fill": "#00A995",
                      "width": 5,
                      "height": 5
                    },
                    {
                      "type": "text",
