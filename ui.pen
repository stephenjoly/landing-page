                      "name": "Reader Modal Contribution 2 Copy",
                      "fill": "#52525B",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Led the development of an operational task inventory and conducted a technology impact analysis to quantify potential disruptions, generating a foundational dataset to support visualization and insight generation.",
                      "lineHeight": 1.48,
                      "fontFamily": "Inter",
                      "fontSize": 11,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
