                                      "layout": "vertical",
                                      "padding": [
                                        0,
                                        0,
                                        0,
                                        25
                                      ],
                                      "alignItems": "center",
                                      "children": [
                                        {
                                          "type": "frame",
                                          "id": "hm3z0",
                                          "name": "div",
                                          "context": "div",
                                          "width": 768,
                                          "height": 796,
                                          "layout": "none",
                                          "children": [
                                            {
                                              "type": "text",
                                              "id": "e3FoeL",
                                              "x": 0,
                                              "y": 3,
                                              "name": "Workstation",
                                              "context": "h2",
                                              "fill": "#27272a",
                                              "content": "Workstation",
                                              "lineHeight": 1.71,
                                              "fontFamily": "Inter",
                                              "fontSize": 14,
                                              "fontWeight": "600"
                                            },
                                            {
                                              "type": "frame",
                                              "id": "G7gOfc",
                                              "x": 192,
                                              "y": 0,
                                              "name": "ul",
                                              "context": "ul",
                                              "width": 576,
                                              "layout": "vertical",
                                              "gap": 64,
                                              "children": [
                                                {
                                                  "type": "frame",
                                                  "id": "hTA0c",
                                                  "name": "li",
                                                  "context": "li",
                                                  "width": "fill_container",
                                                  "height": 132,
                                                  "layout": "vertical",
                                                  "gap": 8,
                                                  "children": [
                                                    {
                                                      "type": "text",
                                                      "id": "p8sf8E",
                                                      "name": "ThinkPad T14 Gen3, Intel i5-1245U, 48GB ",
                                                      "context": "h3",
                                                      "fill": "#27272a",
                                                      "content": "ThinkPad T14 Gen3, Intel i5-1245U, 48GB RAM",
                                                      "lineHeight": 1.75,
                                                      "fontFamily": "Inter",
                                                      "fontSize": 16,
                                                      "fontWeight": "600",
                                                      "letterSpacing": -0.4
                                                    },
                                                    {
                                                      "type": "text",
                                                      "id": "jLmW7",
                                                      "name": "After being a Macbook Pro user for over ",
                                                      "context": "p",
                                                      "fill": "#52525c",
                                                      "textGrowth": "fixed-width-height",
                                                      "width": "fill_container",
                                                      "height": 96,
                                                      "content": "After being a Macbook Pro user for over 10 years, I finally decided to break free and go with Linux on a ThinkPad, the ultimate computing setup from an affordability and repairability perspective. after getting started with Linux as a daily driver in 2024, i landed on NixOS because i love the challenge of it (was previously using arch btw).",
                                                      "lineHeight": 1.71,
                                                      "fontFamily": "Inter",
                                                      "fontSize": 14,
                                                      "fontWeight": "normal"
                                                    }
                                                  ]
                                                },
                                                {
                                                  "type": "frame",
                                                  "id": "thz3E",
                                                  "name": "li",
                                                  "context": "li",
                                                  "width": "fill_container",
                                                  "height": 108,
                                                  "layout": "vertical",
                                                  "gap": 8,
                                                  "children": [
                                                    {
                                                      "type": "text",
                                                      "id": "ptHHy",
                                                      "name": "MOKIN Thunderbolt 4 Dock USB C",
                                                      "context": "h3",
                                                      "fill": "#27272a",
                                                      "content": "MOKIN Thunderbolt 4 Dock USB C",
                                                      "lineHeight": 1.75,
                                                      "fontFamily": "Inter",
                                                      "fontSize": 16,
                                                      "fontWeight": "600",
                                                      "letterSpacing": -0.4
                                                    },
                                                    {
                                                      "type": "text",
                                                      "id": "GARDS",
                                                      "name": "There is no dock that can do what this d",
                                                      "context": "p",
                                                      "fill": "#52525c",
                                                      "textGrowth": "fixed-width-height",
                                                      "width": "fill_container",
                                                      "height": 72,
                                                      "content": "There is no dock that can do what this dock does for the price. 2.5GbE and the ability to run two 2K monitors at 144 Hz was the selling point for me. really helped me to setup a clean and simple workstation for my ThinkPad.",
                                                      "lineHeight": 1.71,
                                                      "fontFamily": "Inter",
                                                      "fontSize": 14,
                                                      "fontWeight": "normal"
                                                    }
                                                  ]
                                                },
                                                {
                                                  "type": "frame",
                                                  "id": "USyQA",
                                                  "name": "li",
                                                  "context": "li",
                                                  "width": "fill_container",
                                                  "height": 108,
                                                  "layout": "vertical",
