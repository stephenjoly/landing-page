                      "fill": "#52525B",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Developed a custom Excel function, “=AskGenAI(<prompt>)”, using VBA to enable secure API calls to Azure-hosted large language models (LLMs), allowing users to interact with Generative AI directly within Excel.",
                      "lineHeight": 1.48,
                      "fontFamily": "Inter",
