                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "KaQaB",
                                      "name": "Software I use, gadgets I love, and othe",
                                      "context": "h1",
                                      "fill": "#27272a",
                                      "textGrowth": "fixed-width-height",
                                      "width": "fill_container",
                                      "height": 168,
                                      "content": "Software I use, gadgets I love, and other things I can't live without.",
                                      "lineHeight": 1.17,
                                      "fontFamily": "Inter",
                                      "fontSize": 48,
                                      "fontWeight": "700",
                                      "letterSpacing": -1.2
                                    },
                                    {
                                      "type": "text",
                                      "id": "pjJz6",
                                      "name": "I sometimes get asked about the things I",
                                      "context": "p",
                                      "fill": "#52525c",
                                      "textGrowth": "fixed-width-height",
                                      "width": "fill_container",
                                      "height": 84,
                                      "content": "I sometimes get asked about the things I use when building software, trying to stay productive, or just whatever new material obsession has been keeping me occupied as of late. Here’s a big list of all of my favourite stuff and my product recommendations.",
                                      "lineHeight": 1.75,
                                      "fontFamily": "Inter",
                                      "fontSize": 16,
                                      "fontWeight": "normal"
                                    }
                                  ]
                                },
                                {
                                  "type": "frame",
                                  "id": "v2dA1",
                                  "name": "div",
                                  "context": "div",
                                  "width": "fill_container",
                                  "layout": "vertical",
                                  "gap": 80,
                                  "children": [
                                    {
                                      "type": "frame",
                                      "id": "wUAAe",
                                      "name": "section",
                                      "context": "section",
                                      "width": "fill_container",
                                      "stroke": "#f4f4f5",
