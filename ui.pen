                                            },
                                            {
                                              "type": "text",
                                              "id": "h3rf3",
                                              "name": "July 11, 2025",
                                              "context": "span",
                                              "fill": "#9f9fa9",
                                              "content": "July 11, 2025",
                                              "lineHeight": 1.75,
                                              "fontFamily": "Inter",
                                              "fontSize": 16,
                                              "fontWeight": "normal"
                                            }
                                          ]
                                        },
                                        {
                                          "type": "text",
                                          "id": "l2vn47",
                                          "name": "What I learned from the 2025 Caribbean C",
                                          "context": "h1",
                                          "fill": "#27272a",
                                          "textGrowth": "fixed-width-height",
                                          "width": "fill_container",
                                          "height": 168,
                                          "content": "What I learned from the 2025 Caribbean Canada Leader Dialogue",
                                          "lineHeight": 1.17,
                                          "fontFamily": "Inter",
                                          "fontSize": 48,
                                          "fontWeight": "700",
                                          "letterSpacing": -1.2
                                        }
                                      ]
                                    },
                                    {
                                      "type": "frame",
                                      "id": "OBcNi",
                                      "name": "div",
                                      "context": "div",
                                      "width": "fill_container",
                                      "height": 9054.06,
                                      "layout": "vertical",
                                      "children": [
                                        {
                                          "type": "text",
                                          "id": "bHjAW",
                                          "name": "Introduction: A Leadership Journey That ",
                                          "context": "h2",
                                          "fill": "#18181b",
                                          "content": "Introduction: A Leadership Journey That Was Anything but Ordinary",
                                          "lineHeight": 1.4,
                                          "fontFamily": "Inter",
                                          "fontSize": 20,
                                          "fontWeight": "600"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "pMiJW",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 16,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "WqWsh",
                                          "name": "Sometimes, we attend events that check a",
                                          "context": "p",
                                          "fill": "#52525c",
                                          "textGrowth": "fixed-width-height",
                                          "width": "fill_container",
                                          "height": 56,
                                          "content": "Sometimes, we attend events that check a box. And sometimes, we participate in something that fundamentally shifts the way we see ourselves, others, and the world around us.",
                                          "lineHeight": 1.75,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "KJ5DU",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 28,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "lLFoD",
                                          "name": "The 2025 Caribbean Canada Leaders Dialog",
                                          "context": "p",
                                          "fill": "#52525c",
                                          "textGrowth": "fixed-width-height",
                                          "width": "fill_container",
                                          "height": 140,
                                          "content": "The 2025 Caribbean Canada Leaders Dialogue (CCLD) was definitely the latter—a dynamic experience that challenged me intellectually, emotionally, and interpersonally. I went in expecting panels and networking opportunities. I walked away with a deeper understanding of inclusive leadership, cross-cultural collaboration, and the socioeconomic intricacies that shape the Caribbean region.",
                                          "lineHeight": 1.75,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "q6XOzz",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 28,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "YCfxD",
                                          "name": "In this article, I want to unpack what t",
                                          "context": "p",
                                          "fill": "#52525c",
                                          "textGrowth": "fixed-width-height",
                                          "width": "fill_container",
                                          "height": 56,
                                          "content": "In this article, I want to unpack what the CCLD is about, highlight the unexpected lessons I learned, and share how it’s already changing how I show up in my work and my life.",
                                          "lineHeight": 1.75,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "Tp8lc",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 40,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "rectangle",
                                          "cornerRadius": 24,
                                          "id": "AtuMk",
                                          "name": "img",
                                          "context": "img",
                                          "fill": {
                                            "type": "image",
                                            "enabled": true,
                                            "url": "ui-assets/b362c288bbbcfe63.jpg",
                                            "mode": "stretch"
                                          },
                                          "width": 554,
                                          "height": 640
                                        },
                                        {
                                          "type": "frame",
                                          "id": "l4HWLq",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 80,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "epSuU",
                                          "name": "What Is the CCLD?",
                                          "context": "h2",
                                          "fill": "#18181b",
                                          "content": "What Is the CCLD?",
                                          "lineHeight": 1.4,
                                          "fontFamily": "Inter",
                                          "fontSize": 20,
                                          "fontWeight": "600"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "juLt9",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 16,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "SwpmA",
                                          "name": "The Caribbean Canada Leaders Dialogue is",
                                          "context": "p",
                                          "fill": "#52525c",
                                          "textGrowth": "fixed-width-height",
                                          "width": "fill_container",
                                          "height": 84,
                                          "content": "The Caribbean Canada Leaders Dialogue is a cross-sectoral exchange program designed to foster leadership, social innovation, and stronger partnerships between Canada and the Caribbean.",
                                          "lineHeight": 1.75,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "Mctle",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 28,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "O8cWg",
                                          "name": "Created under the patronage of the Duke ",
                                          "context": "p",
                                          "fill": "#52525c",
                                          "textGrowth": "fixed-width-height",
                                          "width": "fill_container",
                                          "height": 140,
                                          "content": "Created under the patronage of the Duke of Edinburgh and organized in partnership with institutions across both regions, the program brings together emerging and established leaders from government, civil society, academia, industry, and labor organizations. But what truly sets it apart is its mission: to cultivate deeper human relationships beyond the seats we occupy.",
                                          "lineHeight": 1.75,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "P33OMV",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 28,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "JBFxi",
                                          "name": "The goal isn’t merely to build skills or",
                                          "context": "p",
                                          "fill": "#52525c",
                                          "textGrowth": "fixed-width-height",
                                          "width": "fill_container",
                                          "height": 140,
                                          "content": "The goal isn’t merely to build skills or transfer knowledge—it’s to connect people on a human level. By doing so, the hope is that we become more compassionate, emotionally intelligent, and culturally attuned as decision-makers. The Duke believed that transformative leadership begins by seeing the humanity in one another—and that’s a belief this program put into practice at every turn.",
                                          "lineHeight": 1.75,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "fiEFn",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 40,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "rectangle",
                                          "cornerRadius": 24,
                                          "id": "r7HiuH",
                                          "name": "img",
                                          "context": "img",
                                          "fill": {
                                            "type": "image",
                                            "enabled": true,
                                            "url": "ui-assets/0689bd11f6114830.jpg",
                                            "mode": "stretch"
                                          },
                                          "width": 672,
                                          "height": 301.14
                                        },
                                        {
                                          "type": "frame",
                                          "id": "H0zeC0",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 80,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "Hw3bk",
                                          "name": "What Made It So Special?",
                                          "context": "h2",
                                          "fill": "#18181b",
                                          "content": "What Made It So Special?",
                                          "lineHeight": 1.4,
                                          "fontFamily": "Inter",
                                          "fontSize": 20,
                                          "fontWeight": "600"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "eUpuj",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 16,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "c0JWtA",
                                          "name": "What struck me most about CCLD wasn’t th",
                                          "context": "p",
                                          "fill": "#52525c",
                                          "textGrowth": "fixed-width-height",
                                          "width": "fill_container",
                                          "height": 84,
                                          "content": "What struck me most about CCLD wasn’t the content—it was the people. I had never experienced the Caribbean like this. I met individuals from countries I hadn’t previously engaged with closely, and from walks of life that expanded my understanding of leadership.",
                                          "lineHeight": 1.75,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "fNgGC",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 28,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "Ma0b9",
                                          "name": "We had academics, policymakers, entrepre",
                                          "context": "p",
                                          "fill": "#52525c",
                                          "textGrowth": "fixed-width-height",
                                          "width": "fill_container",
                                          "height": 112,
                                          "content": "We had academics, policymakers, entrepreneurs, civil servants, and grassroots organizers all in one room—not as panelists and audience, but as equals in conversation. Hearing from leaders tackling issues like disaster relief, healthcare access, environmental protection, and labor equity gave me a renewed sense of urgency and purpose.",
                                          "lineHeight": 1.75,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "A9LWLJ",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 28,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "KPoO9",
                                          "name": "It’s rare to be part of a group where th",
                                          "context": "p",
                                          "fill": "#52525c",
                                          "textGrowth": "fixed-width-height",
                                          "width": "fill_container",
                                          "height": 84,
                                          "content": "It’s rare to be part of a group where the shared goal is not to outshine one another, but to deeply connect, collaborate, and co-create sustainable change. CCLD intentionally created that space, and it was powerful.",
                                          "lineHeight": 1.75,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "s0QvOZ",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 40,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "rectangle",
                                          "cornerRadius": 24,
                                          "id": "FPqZn",
                                          "name": "img",
                                          "context": "img",
                                          "fill": {
                                            "type": "image",
                                            "enabled": true,
                                            "url": "ui-assets/1e3b4bc0b80632a0.jpg",
                                            "mode": "stretch"
                                          },
                                          "width": 672,
                                          "height": 447.89
                                        },
                                        {
                                          "type": "frame",
                                          "id": "mghcD",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 80,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "nArYl",
                                          "name": "A Program Built for Adaptability (And Ma",
                                          "context": "h2",
                                          "fill": "#18181b",
                                          "content": "A Program Built for Adaptability (And Maybe a Bit of Chaos)",
                                          "lineHeight": 1.4,
                                          "fontFamily": "Inter",
                                          "fontSize": 20,
                                          "fontWeight": "600"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "C0fhw",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 16,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "Ro70F",
                                          "name": "One thing we learned fast: the program w",
                                          "context": "p",
                                          "fill": "#52525c",
                                          "textGrowth": "fixed-width-height",
                                          "width": "fill_container",
                                          "height": 84,
                                          "content": "One thing we learned fast: the program was tightly packed. There was no downtime, no buffer, and definitely no space set aside for working on our final presentations. That might sound like poor planning—but it was by design.",
                                          "lineHeight": 1.75,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "imTrL",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 28,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "gy3iO",
                                          "name": "Delays, cancellations, missing buses, no",
                                          "context": "p",
                                          "fill": "#52525c",
                                          "textGrowth": "fixed-width-height",
                                          "width": "fill_container",
                                          "height": 84,
                                          "content": "Delays, cancellations, missing buses, not receiving our itinerary until hours after arriving—these were not administrative errors. They were intentional variables introduced to test our patience, emotional regulation, and adaptability.",
                                          "lineHeight": 1.75,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "zGGf8",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 28,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "BYggH",
                                          "name": "At the time, I’ll admit, I was frustrate",
                                          "context": "p",
                                          "fill": "#52525c",
                                          "textGrowth": "fixed-width-height",
                                          "width": "fill_container",
                                          "height": 112,
                                          "content": "At the time, I’ll admit, I was frustrated. But in hindsight, I see what CCLD was doing. It mimicked the uncertainties of real-world leadership: the unpredictability, the curveballs, the need to solve problems under pressure, and the emotional fatigue that can come when you’re being pulled in multiple directions with very little guidance.",
                                          "lineHeight": 1.75,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "USCRL",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 28,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "rPrFJ",
                                          "name": "It was an opportunity to reflect on how ",
                                          "context": "p",
                                          "fill": "#52525c",
                                          "content": "It was an opportunity to reflect on how we show up when nothing is going according to plan.",
                                          "lineHeight": 1.75,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "YeaFu",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 40,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "rectangle",
                                          "cornerRadius": 24,
                                          "id": "tiYan",
                                          "name": "img",
                                          "context": "img",
                                          "fill": {
                                            "type": "image",
                                            "enabled": true,
                                            "url": "ui-assets/087f503a5b785422.jpg",
                                            "mode": "stretch"
                                          },
                                          "width": 672,
                                          "height": 504
                                        },
                                        {
                                          "type": "frame",
                                          "id": "FqhQg",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 80,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "cK6R6",
                                          "name": "Lessons from the Study Tours: Doing Good",
                                          "context": "h2",
                                          "fill": "#18181b",
                                          "textGrowth": "fixed-width-height",
                                          "width": "fill_container",
                                          "height": 56,
                                          "content": "Lessons from the Study Tours: Doing Good Can (and Should) Be Profitable",
                                          "lineHeight": 1.4,
                                          "fontFamily": "Inter",
                                          "fontSize": 20,
                                          "fontWeight": "600"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "o0M0V",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 16,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "TimDK",
                                          "name": "One of the most impactful parts of the p",
                                          "context": "p",
                                          "fill": "#52525c",
                                          "textGrowth": "fixed-width-height",
                                          "width": "fill_container",
                                          "height": 84,
                                          "content": "One of the most impactful parts of the program were the site visits and conversations with people on the ground doing meaningful work. One story that stayed with me was from a sand quarry site that had begun an environmental reclamation effort.",
                                          "lineHeight": 1.75,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "B7fG3",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 28,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "YJybz",
                                          "name": "The land that was once mined and eroded ",
                                          "context": "p",
                                          "fill": "#52525c",
                                          "textGrowth": "fixed-width-height",
                                          "width": "fill_container",
                                          "height": 84,
                                          "content": "The land that was once mined and eroded is now being turned into a wildlife sanctuary and community farm. Not through a massive corporate donation or government intervention—but through a deliberate, creative effort to leave the land better than they found it.",
                                          "lineHeight": 1.75,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "fr5hm",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 28,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "G6I7p",
                                          "name": "This is the kind of leadership we need m",
                                          "context": "p",
                                          "fill": "#52525c",
                                          "content": "This is the kind of leadership we need more of:",
                                          "lineHeight": 1.75,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "g6VYoF",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 40,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "i4MSUn",
                                          "name": "ul",
                                          "context": "ul",
                                          "width": "fill_container",
                                          "layout": "vertical",
                                          "gap": 24,
                                          "padding": [
                                            0,
                                            0,
                                            0,
                                            24
                                          ],
                                          "children": [
                                            {
                                              "type": "frame",
                                              "id": "QxKCW",
                                              "name": "Creative restoration that doesn’t just m",
                                              "context": "li",
                                              "width": "fill_container",
                                              "height": 56,
                                              "layout": "vertical",
                                              "padding": [
                                                0,
                                                0,
                                                0,
                                                14
                                              ],
                                              "justifyContent": "center",
                                              "children": [
                                                {
                                                  "type": "text",
                                                  "id": "h43Fu",
                                                  "fill": "#52525c",
                                                  "textGrowth": "fixed-width",
                                                  "width": 634,
                                                  "content": "Creative restoration that doesn’t just mitigate harm, but reimagines what reclamation can look like.",
                                                  "lineHeight": 1.75,
                                                  "fontFamily": "Inter",
                                                  "fontSize": 16,
                                                  "fontWeight": "normal"
                                                }
                                              ]
                                            },
                                            {
                                              "type": "frame",
                                              "id": "n5lGb",
                                              "name": "Economic sustainability baked into the m",
                                              "context": "li",
                                              "width": "fill_container",
                                              "height": 56,
                                              "layout": "vertical",
                                              "padding": [
                                                0,
                                                0,
                                                0,
                                                14
                                              ],
                                              "justifyContent": "center",
                                              "children": [
                                                {
                                                  "type": "text",
                                                  "id": "RVCyT",
                                                  "fill": "#52525c",
                                                  "textGrowth": "fixed-width",
                                                  "width": 634,
                                                  "content": "Economic sustainability baked into the mission so doing good isn’t an expense, but part of the value chain.",
                                                  "lineHeight": 1.75,
                                                  "fontFamily": "Inter",
                                                  "fontSize": 16,
                                                  "fontWeight": "normal"
                                                }
                                              ]
                                            }
                                          ]
                                        },
                                        {
                                          "type": "frame",
                                          "id": "sfr5p",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 40,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "COX7g",
                                          "name": "This example made it clear: when we dest",
                                          "context": "p",
                                          "fill": "#52525c",
                                          "textGrowth": "fixed-width-height",
                                          "width": "fill_container",
                                          "height": 56,
                                          "content": "This example made it clear: when we destroy something, we have a responsibility to build something better in return. Not necessarily in function—but in value.",
                                          "lineHeight": 1.75,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "g6lsPz",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 28,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "cpRRB",
                                          "name": "It shouldn't be revolutionary to think t",
                                          "context": "p",
                                          "fill": "#52525c",
                                          "textGrowth": "fixed-width-height",
                                          "width": "fill_container",
                                          "height": 112,
                                          "content": "It shouldn't be revolutionary to think that every resource-extractive project should have a restorative counterpart. What would it look like if governments required this of corporations? What if we structured businesses to support environmental or social legacies as a standard, not an exception?",
                                          "lineHeight": 1.75,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "FnCxk",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 28,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "TlYrK",
                                          "name": "The lesson is simple: doing good shouldn",
                                          "context": "p",
                                          "fill": "#52525c",
                                          "textGrowth": "fixed-width-height",
                                          "width": "fill_container",
                                          "height": 56,
                                          "content": "The lesson is simple: doing good shouldn’t be charity. It should be smart business—and the leadership challenge is figuring out how to engineer that reality everywhere we can.",
                                          "lineHeight": 1.75,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "LOrGz",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 40,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "rectangle",
                                          "cornerRadius": 24,
                                          "id": "nMspa",
                                          "name": "img",
                                          "context": "img",
                                          "fill": {
                                            "type": "image",
                                            "enabled": true,
                                            "url": "ui-assets/416e2e8f731b85d5.jpg",
                                            "mode": "stretch"
                                          },
                                          "width": 672,
                                          "height": 448.52
                                        },
                                        {
                                          "type": "frame",
                                          "id": "FGcyY",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 80,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "SQWkA",
                                          "name": "What I Learned About Leadership From the",
                                          "context": "h2",
                                          "fill": "#18181b",
                                          "content": "What I Learned About Leadership From the Experience",
                                          "lineHeight": 1.4,
                                          "fontFamily": "Inter",
                                          "fontSize": 20,
                                          "fontWeight": "600"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "y5DguC",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 16,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "rBrWP",
                                          "name": "1. Compassion and Inclusion as Strategy",
                                          "context": "h3",
                                          "fill": "#18181b",
                                          "content": "1. Compassion and Inclusion as Strategy",
                                          "lineHeight": 1.75,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "600"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "ADjQf",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 16,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "f87BtC",
                                          "name": "Being a “good leader” is not just about ",
                                          "context": "p",
                                          "fill": "#52525c",
                                          "textGrowth": "fixed-width-height",
                                          "width": "fill_container",
                                          "height": 56,
                                          "content": "Being a “good leader” is not just about getting results. It’s about creating spaces where everyone feels heard, valued, and part of the solution. Inclusive leadership requires intention:",
                                          "lineHeight": 1.75,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "ua5YW",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 40,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "DI8DP",
                                          "name": "ul",
                                          "context": "ul",
                                          "width": "fill_container",
                                          "layout": "vertical",
                                          "gap": 24,
                                          "padding": [
                                            0,
                                            0,
                                            0,
                                            24
                                          ],
                                          "children": [
                                            {
                                              "type": "frame",
                                              "id": "N4Lxe",
                                              "name": "Holding space for diverse voices",
                                              "context": "li",
                                              "width": "fill_container",
                                              "height": 28,
                                              "layout": "vertical",
                                              "padding": [
                                                0,
                                                0,
                                                0,
                                                14
                                              ],
                                              "justifyContent": "center",
                                              "children": [
                                                {
                                                  "type": "text",
                                                  "id": "RANRu",
                                                  "fill": "#52525c",
                                                  "content": "Holding space for diverse voices",
                                                  "lineHeight": 1.75,
                                                  "fontFamily": "Inter",
                                                  "fontSize": 16,
                                                  "fontWeight": "normal"
                                                }
                                              ]
                                            },
                                            {
                                              "type": "frame",
                                              "id": "f4tydF",
                                              "name": "Acknowledging conflict and naming it",
                                              "context": "li",
                                              "width": "fill_container",
                                              "height": 28,
                                              "layout": "vertical",
                                              "padding": [
                                                0,
                                                0,
                                                0,
                                                14
                                              ],
                                              "justifyContent": "center",
                                              "children": [
                                                {
                                                  "type": "text",
                                                  "id": "nABCz",
                                                  "fill": "#52525c",
                                                  "content": "Acknowledging conflict and naming it",
                                                  "lineHeight": 1.75,
                                                  "fontFamily": "Inter",
                                                  "fontSize": 16,
                                                  "fontWeight": "normal"
                                                }
                                              ]
                                            },
                                            {
                                              "type": "frame",
                                              "id": "SAfIE",
                                              "name": "Seeking alignment, not just consensus",
                                              "context": "li",
                                              "width": "fill_container",
                                              "height": 28,
                                              "layout": "vertical",
                                              "padding": [
                                                0,
                                                0,
                                                0,
                                                14
                                              ],
                                              "justifyContent": "center",
                                              "children": [
                                                {
                                                  "type": "text",
                                                  "id": "XBug1",
                                                  "fill": "#52525c",
                                                  "content": "Seeking alignment, not just consensus",
                                                  "lineHeight": 1.75,
                                                  "fontFamily": "Inter",
                                                  "fontSize": 16,
                                                  "fontWeight": "normal"
                                                }
                                              ]
                                            }
                                          ]
                                        },
                                        {
                                          "type": "frame",
                                          "id": "DAVzy",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 40,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "gG8HZ",
                                          "name": "There’s a world of difference between “e",
                                          "context": "p",
                                          "fill": "#52525c",
                                          "textGrowth": "fixed-width-height",
                                          "width": "fill_container",
                                          "height": 112,
                                          "content": "There’s a world of difference between “everyone gets a vote” and “everyone gets heard.” And sometimes, democracy is messy—or even unwise. In one group deliberation, I saw firsthand how majority consensus can lead to decisions that, while popular, may not be strategic or well-informed.",
                                          "lineHeight": 1.75,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "YGl0A",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 28,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "s4gPel",
                                          "name": "Leadership isn’t about always leaning in",
                                          "context": "p",
                                          "fill": "#52525c",
                                          "textGrowth": "fixed-width-height",
                                          "width": "fill_container",
                                          "height": 56,
                                          "content": "Leadership isn’t about always leaning into consensus—it’s about discerning when to guide, when to step aside, and when to challenge the prevailing wisdom.",
                                          "lineHeight": 1.75,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "th84S",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 64,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "pctYQ",
                                          "name": "2. Bonding Before Performing",
                                          "context": "h3",
                                          "fill": "#18181b",
                                          "content": "2. Bonding Before Performing",
                                          "lineHeight": 1.75,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "600"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "teDTf",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 16,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "I9cVv9",
                                          "name": "Our team was the largest group in the di",
                                          "context": "p",
                                          "fill": "#52525c",
                                          "textGrowth": "fixed-width-height",
                                          "width": "fill_container",
                                          "height": 56,
                                          "content": "Our team was the largest group in the dialogue—16 people—a size that promised chaos. But by the end, we were the most closely knit group in the program. Why?",
                                          "lineHeight": 1.75,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "G209FK",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 28,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "S6rPNw",
                                          "name": "Because we made time to bond first.",
                                          "context": "p",
                                          "fill": "#52525c",
                                          "content": "Because we made time to bond first.",
                                          "lineHeight": 1.75,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "c1k4O",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 28,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "H9512",
                                          "name": "We created space for laughter, side conv",
                                          "context": "p",
                                          "fill": "#52525c",
                                          "textGrowth": "fixed-width-height",
                                          "width": "fill_container",
                                          "height": 84,
                                          "content": "We created space for laughter, side conversations, dancing, storytelling, and dinner chats. And that psychological safety carried through to our presentation, where we received genuine feedback about how cohesive and warm our dynamic was.",
                                          "lineHeight": 1.75,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "hBTI3",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 28,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "JrCEl",
                                          "name": "Yes, bonding was accelerated by surprise",
                                          "context": "p",
                                          "fill": "#52525c",
                                          "textGrowth": "fixed-width-height",
                                          "width": "fill_container",
                                          "height": 84,
                                          "content": "Yes, bonding was accelerated by surprise bus delays, canceled meetings, and a few late-night rum sessions—but the real glue was the commitment to create an inclusive space where everyone could belong.",
                                          "lineHeight": 1.75,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "xt1jf",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 64,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "XrdnU",
                                          "name": "3. Communication Is More Than Content",
                                          "context": "h3",
                                          "fill": "#18181b",
                                          "content": "3. Communication Is More Than Content",
                                          "lineHeight": 1.75,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "600"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "UgLRV",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 16,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "VToSq",
                                          "name": "Another recurring theme was how we commu",
                                          "context": "p",
                                          "fill": "#52525c",
                                          "textGrowth": "fixed-width-height",
                                          "width": "fill_container",
                                          "height": 56,
                                          "content": "Another recurring theme was how we communicated. It wasn’t just about having ideas, but about practicing clarity, respect, and timing.",
                                          "lineHeight": 1.75,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "BbtWA",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 28,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "U9PJ1P",
                                          "name": "As someone who loves to dig into the phi",
                                          "context": "p",
                                          "fill": "#52525c",
                                          "textGrowth": "fixed-width-height",
                                          "width": "fill_container",
                                          "height": 84,
                                          "content": "As someone who loves to dig into the philosophical and structural side of things, I initially struggled with our group’s desire for efficiency over depth. At one point, I realized that my usual debate-heavy style wasn’t welcome—it slowed us down.",
                                          "lineHeight": 1.75,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "hGnsd",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 28,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "VmQrH",
                                          "name": "So I pivoted. I learned to participate m",
                                          "context": "p",
                                          "fill": "#52525c",
                                          "textGrowth": "fixed-width-height",
                                          "width": "fill_container",
                                          "height": 84,
                                          "content": "So I pivoted. I learned to participate more concisely, and sometimes even let go of ideas that weren’t resonating with the group. That wasn’t easy for me. But I realized that leadership also means knowing when you’re helping—and when you’re not.",
                                          "lineHeight": 1.75,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "QAXuI",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 28,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "tIOos",
                                          "name": "A quote that stuck with me came from our",
                                          "context": "p",
                                          "fill": "#52525c",
                                          "content": "A quote that stuck with me came from our team lead, Cara Lambee:",
                                          "lineHeight": 1.75,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "XUxNu",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 40,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "nzg3R",
                                          "name": "blockquote",
                                          "context": "blockquote",
                                          "width": "fill_container",
                                          "stroke": "#e4e4e7",
                                          "strokeWidth": {
                                            "left": 2
                                          },
                                          "strokeAlignment": "inner",
                                          "layout": "vertical",
                                          "padding": [
                                            0,
                                            0,
                                            0,
                                            26
                                          ],
                                          "children": [
                                            {
                                              "type": "text",
                                              "id": "IStVc",
                                              "name": "“We all have skills we need to refine. S",
                                              "context": "p",
                                              "fill": "#52525c",
                                              "textGrowth": "fixed-width-height",
                                              "width": "fill_container",
                                              "height": 56,
                                              "content": "“We all have skills we need to refine. Some of us need to speak more. Others—like you—need to speak less.”",
                                              "lineHeight": 1.75,
                                              "fontFamily": "Inter",
                                              "fontSize": 16,
                                              "fontWeight": "normal",
                                              "fontStyle": "italic"
                                            }
                                          ]
                                        },
                                        {
                                          "type": "frame",
                                          "id": "RbWRQ",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 40,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "p5Gih",
                                          "name": "It landed. And I appreciated the honesty",
                                          "context": "p",
                                          "fill": "#52525c",
                                          "content": "It landed. And I appreciated the honesty.",
                                          "lineHeight": 1.75,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "gpIIL",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 40,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "rectangle",
                                          "cornerRadius": 24,
                                          "id": "qzKp5",
                                          "name": "img",
                                          "context": "img",
                                          "fill": {
                                            "type": "image",
                                            "enabled": true,
                                            "url": "ui-assets/5be6bec4be0b1fab.jpg",
                                            "mode": "stretch"
                                          },
                                          "width": 672,
                                          "height": 448.52
                                        },
                                        {
                                          "type": "frame",
                                          "id": "agakH",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 79.99,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "vCFmt",
                                          "name": "Final Reflections: How This Changed Me",
                                          "context": "h2",
                                          "fill": "#18181b",
                                          "content": "Final Reflections: How This Changed Me",
                                          "lineHeight": 1.4,
                                          "fontFamily": "Inter",
                                          "fontSize": 20,
                                          "fontWeight": "600"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "qnSmi",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 16,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "GG9ow",
                                          "name": "This experience didn’t just give me a ne",
                                          "context": "p",
                                          "fill": "#52525c",
                                          "textGrowth": "fixed-width-height",
                                          "width": "fill_container",
                                          "height": 56,
                                          "content": "This experience didn’t just give me a new appreciation for Caribbean leadership—it gave me a mirror to reflect on how I lead, communicate, and operate.",
                                          "lineHeight": 1.75,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "qHB9r",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 64,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "M28gmB",
                                          "name": "What I’m Taking With Me:",
                                          "context": "h3",
                                          "fill": "#18181b",
                                          "content": "What I’m Taking With Me:",
                                          "lineHeight": 1.75,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "600"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "wlYLp",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 24,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "S9TFF",
                                          "name": "ul",
                                          "context": "ul",
                                          "width": "fill_container",
                                          "layout": "vertical",
                                          "gap": 24,
                                          "padding": [
                                            0,
                                            0,
                                            0,
                                            24
                                          ],
                                          "children": [
                                            {
                                              "type": "frame",
                                              "id": "Ud9Mb",
                                              "name": "A Newfound Love for the Caribbean: Bread",
                                              "context": "li",
                                              "width": "fill_container",
                                              "height": 84,
                                              "layout": "vertical",
                                              "padding": [
                                                0,
                                                0,
                                                0,
                                                14
                                              ],
                                              "justifyContent": "center",
                                              "children": [
                                                {
                                                  "type": "text",
                                                  "id": "nftoE",
                                                  "fill": "#52525c",
                                                  "textGrowth": "fixed-width",
                                                  "width": 634,
                                                  "content": "A Newfound Love for the Caribbean: Breadfruit, rum, and all. But more than just tastes and sounds, a true appreciation for the people, complexity, resilience, and potential of the region.",
                                                  "lineHeight": 1.75,
                                                  "fontFamily": "Inter",
                                                  "fontSize": 16,
                                                  "fontWeight": "normal"
                                                }
                                              ]
                                            },
                                            {
                                              "type": "frame",
                                              "id": "IzPbk",
                                              "name": "The Tension Between Perfection and Execu",
                                              "context": "li",
                                              "height": 84,
                                              "layout": "vertical",
                                              "padding": [
                                                0,
                                                0,
                                                0,
                                                14
                                              ],
                                              "justifyContent": "center",
                                              "children": [
                                                {
                                                  "type": "text",
                                                  "id": "vlz1v",
                                                  "fill": "#52525c",
                                                  "textGrowth": "fixed-width",
                                                  "width": 634,
                                                  "content": "The Tension Between Perfection and Execution: I love deep thinking and first principles. But sometimes, teams just need to ship the work. “Good enough” exists for a reason.",
                                                  "lineHeight": 1.75,
                                                  "fontFamily": "Inter",
                                                  "fontSize": 16,
                                                  "fontWeight": "normal"
                                                }
                                              ]
                                            },
                                            {
                                              "type": "frame",
                                              "id": "UyQBO",
                                              "name": "Letting Go of Control: Not everything is",
                                              "context": "li",
                                              "width": "fill_container",
                                              "height": 56,
                                              "layout": "vertical",
                                              "padding": [
                                                0,
                                                0,
                                                0,
                                                14
                                              ],
                                              "justifyContent": "center",
                                              "children": [
                                                {
                                                  "type": "text",
                                                  "id": "ThjFT",
                                                  "fill": "#52525c",
                                                  "textGrowth": "fixed-width",
                                                  "width": 634,
                                                  "content": "Letting Go of Control: Not everything is mine to fix. Sometimes, the act of not stepping in is the right kind of leadership.",
                                                  "lineHeight": 1.75,
                                                  "fontFamily": "Inter",
                                                  "fontSize": 16,
                                                  "fontWeight": "normal"
                                                }
                                              ]
                                            },
                                            {
                                              "type": "frame",
                                              "id": "dw5rE",
                                              "name": "Balancing Financial Viability with Socia",
                                              "context": "li",
                                              "width": "fill_container",
                                              "height": 84,
                                              "layout": "vertical",
                                              "padding": [
                                                0,
                                                0,
                                                0,
                                                14
                                              ],
                                              "justifyContent": "center",
                                              "children": [
                                                {
                                                  "type": "text",
                                                  "id": "H9G76",
                                                  "fill": "#52525c",
                                                  "textGrowth": "fixed-width",
                                                  "width": 634,
                                                  "content": "Balancing Financial Viability with Social Good: You can’t fund the change you want to see if you don’t have fuel. We need models that support making an impact sustainably—and that includes supportive policy, business incentives, and funding architecture.",
                                                  "lineHeight": 1.75,
                                                  "fontFamily": "Inter",
                                                  "fontSize": 16,
                                                  "fontWeight": "normal"
                                                }
                                              ]
                                            }
                                          ]
                                        },
                                        {
                                          "type": "frame",
                                          "id": "bGQ4c",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 40,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "rectangle",
                                          "cornerRadius": 24,
                                          "id": "LSKQO",
                                          "name": "img",
                                          "context": "img",
                                          "fill": {
                                            "type": "image",
                                            "enabled": true,
                                            "url": "ui-assets/a6930b489d857db5.jpg",
                                            "mode": "stretch"
                                          },
                                          "width": 672,
                                          "height": 504
                                        },
                                        {
                                          "type": "frame",
                                          "id": "raTqj",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 80,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "CK7Il",
                                          "name": "Closing Thought:",
                                          "context": "h2",
                                          "fill": "#18181b",
                                          "content": "Closing Thought:",
                                          "lineHeight": 1.4,
                                          "fontFamily": "Inter",
                                          "fontSize": 20,
                                          "fontWeight": "600"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "P5L7ww",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 16,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "VxTx0",
                                          "name": "I didn’t walk away with a certificate th",
                                          "context": "p",
                                          "fill": "#52525c",
                                          "textGrowth": "fixed-width-height",
                                          "width": "fill_container",
                                          "height": 84,
                                          "content": "I didn’t walk away with a certificate that says I’m a better leader now. But I did walk away more accountable, more aware, and more inspired to find ways to lead with integrity, inclusivity, and impact.",
                                          "lineHeight": 1.75,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "Uxn6m",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 28,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "TQtSf",
                                          "name": "Because that’s what leadership really is",
                                          "context": "p",
                                          "fill": "#52525c",
                                          "textGrowth": "fixed-width-height",
                                          "width": "fill_container",
                                          "height": 56,
                                          "content": "Because that’s what leadership really is. Not control, not charisma, not accomplishment. Leadership is connection.",
                                          "lineHeight": 1.75,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "frame",
                                          "id": "NAJEq",
                                          "name": "spacer",
                                          "width": "fill_container",
                                          "height": 28,
                                          "layout": "none"
                                        },
                                        {
                                          "type": "text",
                                          "id": "j7vEdr",
                                          "name": "And the 2025 CCLD built that—one convers",
                                          "context": "p",
                                          "fill": "#52525c",
                                          "content": "And the 2025 CCLD built that—one conversation, crisis, and cup of rum at a time.",
                                          "lineHeight": 1.75,
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "normal"
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
