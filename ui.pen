                      "name": "Reader Modal Contribution 5 Copy",
                      "fill": "#52525B",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Oversaw and supported a team of two in shaping the stakeholder engagement approach and planning for short- to medium-term sustainability of the solution.",
                      "lineHeight": 1.48,
                      "fontFamily": "Inter",
                      "fontSize": 11,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
