                      "children": [
                        {
                          "type": "frame",
                          "id": "f5Qou",
                          "name": "div",
                          "context": "div",
                          "width": "fill_container",
                          "layout": "vertical",
                          "padding": [
                            0,
                            48
                          ],
                          "children": [
                            {
                              "type": "frame",
                              "id": "M6I7J",
                              "name": "div",
                              "context": "div",
                              "width": "fill_container",
                              "layout": "vertical",
                              "gap": 48,
                              "children": [
                                {
                                  "type": "frame",
                                  "id": "Rzka6",
                                  "width": "fill_container",
                                  "height": 380.5,
                                  "children": [
                                    {
                                      "type": "frame",
                                      "id": "d6BtG",
                                      "name": "div",
                                      "context": "div",
                                      "width": "fill_container",
                                      "height": 1060,
                                      "layout": "vertical",
                                      "gap": 24,
                                      "children": [
                                        {
                                          "type": "text",
                                          "id": "BbHh8",
                                          "name": "I’m Stephen. I live in Toronto, where I ",
                                          "context": "h1",
                                          "fill": "#27272a",
                                          "textGrowth": "fixed-width-height",
                                          "width": "fill_container",
                                          "height": 168,
                                          "content": "I’m Stephen. I live in Toronto, where I help companies evolve.",
                                          "lineHeight": 1.17,
                                          "fontFamily": "Inter",
                                          "fontSize": 48,
                                          "fontWeight": "700",
                                          "letterSpacing": -1.2
                                        },
                                        {
                                          "type": "frame",
                                          "id": "z3PUt",
                                          "name": "div",
                                          "context": "div",
                                          "width": "fill_container",
                                          "height": 868,
                                          "layout": "vertical",
                                          "gap": 28,
                                          "children": [
                                            {
                                              "type": "text",
                                              "id": "RoBBZ",
                                              "name": "I’m Stephen. I live in Toronto, where I ",
                                              "context": "p",
                                              "fill": "#52525c",
                                              "content": "I’m Stephen. I live in Toronto, where I help companies evolve.",
                                              "lineHeight": 1.75,
                                              "fontFamily": "Inter",
                                              "fontSize": 16,
                                              "fontWeight": "normal"
                                            },
                                            {
                                              "type": "text",
                                              "id": "RNDL9",
                                              "name": "Curiosity has always been my fuel. As a ",
                                              "context": "p",
                                              "fill": "#52525c",
                                              "textGrowth": "fixed-width-height",
                                              "width": "fill_container",
                                              "height": 140,
                                              "content": "Curiosity has always been my fuel. As a kid, I couldn’t resist opening every drawer in the house just to see what was inside. My aunt, a chemistry professor, fed that spark with test tubes and food coloring — I’d spend hours mixing colors, fascinated by how simple things could combine into something new.",
                                              "lineHeight": 1.75,
                                              "fontFamily": "Inter",
                                              "fontSize": 16,
                                              "fontWeight": "normal"
                                            },
                                            {
                                              "type": "text",
                                              "id": "csL5l",
                                              "name": "That sense of discovery carried me throu",
                                              "context": "p",
                                              "fill": "#52525c",
                                              "textGrowth": "fixed-width-height",
                                              "width": "fill_container",
                                              "height": 112,
                                              "content": "That sense of discovery carried me through high school, where I launched a student newspaper and supported younger students in my community. It’s also what drew me to engineering — the perfect mix of creativity, structure, and real-world impact.",
                                              "lineHeight": 1.75,
                                              "fontFamily": "Inter",
                                              "fontSize": 16,
                                              "fontWeight": "normal"
                                            },
                                            {
                                              "type": "text",
                                              "id": "Y28NV",
                                              "name": "Professionally, I’m the Manager of Custo",
                                              "context": "p",
                                              "fill": "#52525c",
                                              "textGrowth": "fixed-width-height",
                                              "width": "fill_container",
                                              "height": 336,
                                              "content": "Professionally, I’m the Manager of Customer Deployment for Dayforce's Strategic Workforce Planning product. I came to Dayforce through Agentnoon, a Y Combinator-backed startup building organizational design and workforce planning software that was later acquired by Dayforce. Today I lead the post-sale customer lifecycle across onboarding, implementation, support, training, and product feedback, working at the intersection of customers, sales, and engineering. Before that, I spent six years at Deloitte, where I advised clients on regulatory risk, operational resilience, and workforce strategy before moving into the Office of Generative AI to focus on internal AI enablement, product development, and scalable delivery.",
                                              "lineHeight": 1.75,
                                              "fontFamily": "Inter",
                                              "fontSize": 16,
                                              "fontWeight": "normal"
                                            },
                                            {
                                              "type": "text",
                                              "id": "k0t6t",
                                              "name": "When I’m not working, I’m usually tinker",
                                              "context": "p",
                                              "fill": "#52525c",
                                              "textGrowth": "fixed-width-height",
                                              "width": "fill_container",
                                              "height": 140,
                                              "content": "When I’m not working, I’m usually tinkering with small apps in my home lab, or reading about mental health, economics, and behavioral science — always searching for ways to understand people better, and build systems that make life work a little smoother at scale.",
                                              "lineHeight": 1.75,
                                              "fontFamily": "Inter",
                                              "fontSize": 16,
                                              "fontWeight": "normal"
                                            }
                                          ]
                                        }
                                      ]
                                    },
                                    {
                                      "type": "frame",
                                      "id": "lrzO7",
                                      "name": "div",
                                      "context": "div",
                                      "width": "fill_container",
                                      "height": 380.5,
                                      "layout": "vertical",
                                      "padding": [
                                        0,
