                  "name": "About Biography",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 22,
                  "children": [
                    {
                      "type": "text",
                      "id": "evYpj",
                      "name": "About Heading",
                      "fill": "#F4F4F5",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "I’m Stephen. I live in Toronto, where I help companies evolve.",
                      "lineHeight": 1.08,
                      "fontFamily": "Inter",
                      "fontSize": 46,
                      "fontWeight": "700",
                      "letterSpacing": -1.1
                    },
                    {
                      "type": "text",
                      "id": "bi0cG",
                      "name": "Biography Paragraph 1",
                      "fill": "#A1A1AA",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "I’m Stephen, a Toronto-based engineer and product-minded builder focused on customer outcomes, clear systems, and thoughtful execution.",
                      "lineHeight": 1.65,
                      "fontFamily": "Inter",
                      "fontSize": 15,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "ZmQeR",
                      "name": "Biography Paragraph 2",
                      "fill": "#A1A1AA",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "I lead customer deployment for Strategic Workforce Planning at Dayforce. Outside work, I build tools, explore home lab systems, travel, and make photographs.",
                      "lineHeight": 1.65,
                      "fontFamily": "Inter",
                      "fontSize": 15,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "we2s9",
                      "name": "Biography Paragraph 3",
                      "fill": "#A1A1AA",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Contact details and my full résumé stay private. Recruiters and collaborators can request access directly—no account or password needed.",
                      "lineHeight": 1.65,
                      "fontFamily": "Inter",
                      "fontSize": 15,
                      "fontWeight": "normal"
                    }
                  ]
                },
